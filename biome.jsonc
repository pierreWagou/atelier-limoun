{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Two ignore layers, keep both: `vcs.useIgnoreFile` makes .gitignore the
  // single source of truth (Biome v2 ignores it unless VCS integration is
  // enabled), while the explicit `!` entries below keep lint hermetic when
  // git metadata is absent (tarball export, VCS change). Either layer failing
  // alone must never re-scan ignored local-only artifacts (see c6f1380).
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.tmp",
      "!**/.astro",
      "!**/cms/public/uploads",
      "!**/cms/.strapi",
      "!**/cms/.strapi-updater.json",
      "!**/docs/.vitepress/cache",
      "!**/cms/types/generated",
      "!**/package-lock.json",
      "!**/site/test-results",
      "!**/site/playwright-report",
      "!**/site/blob-report"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["cms/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "warn"
          }
        }
      }
    }
  ]
}
