# Copy to .env for local development
HOST=0.0.0.0
PORT=1337
APP_KEYS=key1secret,key2secret
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me

# On Dokploy, set DATABASE_CLIENT=postgres and the DATABASE_* vars
# from your Dokploy Postgres service instead of the sqlite default.
# DATABASE_CLIENT=postgres
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=
# DATABASE_USERNAME=
# DATABASE_PASSWORD=

# Optional: URL that triggers a site rebuild on content publish
# (e.g. Dokploy deploy hook for the Astro app)
# SITE_REBUILD_URL=
# SITE_REBUILD_TOKEN=
